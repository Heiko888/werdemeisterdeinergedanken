# Vorlage für deploy/.env (Produktion auf Hetzner).
# Kopieren:  cp deploy/.env.example deploy/.env  und Werte eintragen.
# deploy/.env NICHT committen (steht in .gitignore).

# --- Supabase (BUILD-Zeit, wird ins Client-Bundle eingebacken) ---
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-ODER-PUBLISHABLE-KEY

# --- Host-Kanonisierung (Laufzeit) ---
# true  = neu./nackte Domain → 301 auf www (Standard, sobald www live ist)
# false = vorübergehend abschalten, solange www noch nicht ausgeliefert wird
ENFORCE_CANONICAL_HOST=true

# --- Kontaktformular / Resend (Laufzeit) ---
RESEND_API_KEY=re_DEIN_API_KEY
CONTACT_TO=heiko.schwaninger@gmail.com
CONTACT_FROM=Werde Meister deiner Gedanken <onboarding@resend.dev>

# --- Google Analytics 4 (Laufzeit) ---
# Kein Code-Default mehr: ohne diese Variable bleibt Analytics inaktiv.
# In Produktion setzen, damit weiterhin gemessen wird (GA lädt erst nach
# aktiver Cookie-Einwilligung).
NEXT_PUBLIC_GA_ID=G-XF5D83V7HD

# --- Vorlagen-Galerie (Laufzeit, optional) ---
# Host-Ordner mit den Vorlagen-Dateien, der read-only in den Container
# (/app/content/vorlagen) gemountet wird. Standard ist /opt/website-vorlagen –
# nur setzen, wenn die Dateien woanders liegen. Befüllt/aktualisiert wird der
# Ordner mit tools/deploy/update-vorlagen-galerie.sh.
# VORLAGEN_VOLUME_DIR=/opt/website-vorlagen
