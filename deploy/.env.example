# Vorlage für die Umgebungsvariablen der Website.
#
# ACHTUNG – Ort: Produktiv liest der Compose-Stack sie aus
#   /opt/mattermost/.env
# (nicht aus deploy/.env – eine solche Datei existiert auf dem Server nicht).
# Diese Vorlage dokumentiert, was dort hineingehört. Nichts davon committen.
#
# Nach Änderung:
#   NEXT_PUBLIC_*  → Rebuild nötig  (up -d --build website)
#   alles andere   → Neustart reicht (up -d website)

# ─── Supabase ────────────────────────────────────────────────────────────
# BUILD-Zeit: wird ins Client-Bundle eingebacken.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-ODER-PUBLISHABLE-KEY
# LAUFZEIT, serverseitig. Umgeht sämtliche Row-Level-Security – nur für
# API-Routen (E-Book-Leads, Impuls-Versand). Niemals mit NEXT_PUBLIC_-Präfix.
SUPABASE_SERVICE_ROLE_KEY=DEIN-SERVICE-ROLE-KEY

# ─── Google Analytics 4 ──────────────────────────────────────────────────
# BUILD-Zeit. Kein Code-Default: ohne diesen Wert bleiben Analytics UND der
# Cookie-Banner still inaktiv (src/lib/analytics.ts). GA lädt ohnehin erst
# nach aktiver Einwilligung.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── E-Mail-Versand (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_DEIN_API_KEY

# ─── Admin-Zugang ────────────────────────────────────────────────────────
# Kommagetrennte Adressen für /admin.
# ACHTUNG: Die Variable wird von Compose IMMER gesetzt. Bleibt sie hier leer,
# kommt "" im Container an – src/lib/admin.ts fällt aber nur bei undefined
# auf seine eingebaute Liste zurück (`??`), nicht bei "". Ein leerer Wert
# sperrt damit ALLE aus /admin aus. Also gefüllt lassen.
ADMIN_EMAILS=deine.adresse@example.com

# ─── Cron / geschützte Routen ────────────────────────────────────────────
# Schützt /api/impulses (Serienversand). Ohne Wert lehnt die Route alles ab.
CRON_SECRET=EIN-LANGES-ZUFALLSGEHEIMNIS

# ─── KI-Reading zum Gedankenprofil ───────────────────────────────────────
# /mitglieder/gedankenprofil. Fehlt der Wert, blendet die Seite die
# Reading-Option aus – kein Fehler. Serverseitig, niemals NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-DEIN-KEY

# ─── Host-Kanonisierung ──────────────────────────────────────────────────
# true = Apex und "neu." per 301 auf www. Seit dem Cutover dauerhaft true.
ENFORCE_CANONICAL_HOST=true

# ─── Vom Code gelesen, produktiv derzeit NICHT gesetzt ───────────────────
# Alle haben einen Fallback – es ist nichts kaputt, es greift der Standard.
# Erst verdrahten, wenn die eigene Resend-Domain steht (sonst lehnt Resend
# fremde Absenderadressen ab). Wer sie setzt, muss sie AUCH in
# /opt/mattermost/docker-compose.yml als environment:-Zeile ergänzen –
# eine Variable allein in der .env erreicht den Container nicht.
#
# CONTACT_TO=          # Empfänger Kontaktformular   (Fallback: site.email)
# CONTACT_FROM=        # Absender Kontaktformular    (Fallback: onboarding@resend.dev)
# EBOOK_FROM=          # Absender E-Book-Auslieferung
# MEMBERSHIP_FROM=     # Absender Mitgliedschafts-Mails
# IMPULSE_FROM=        # Absender der E-Mail-Impulse
# BUCH_FROM=           # Absender Buch-Auslieferung
# BUCH_DOWNLOAD_SECRET= # signierte Buch-Downloads (Fallback: STRIPE_WEBHOOK_SECRET)
#
# Schalter – der Code prüft strikt === "true", alles andere gilt als aus:
# REQUIRE_ACTIVE_MEMBERSHIP=false
# ALLOW_SELF_REGISTRATION=false
#
# Bezahlweg (ohne Werte inaktiv):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# STRIPE_PRICE_ID_YEARLY=
# STRIPE_BOOK_PRICE_ID=
# STRIPE_BOOK_PRICE_ID_PRINT=
