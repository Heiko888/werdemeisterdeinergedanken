# Supabase – Mitgliederbereich
# Werte findest du im Supabase-Dashboard unter: Project Settings → API
# Diese Datei nach ".env.local" kopieren und Werte eintragen (lokal),
# bzw. in Vercel unter Settings → Environment Variables hinterlegen.

NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-ODER-PUBLISHABLE-KEY

# Kontaktformular – Resend (https://resend.com)
# RESEND_API_KEY ist Pflicht für den Versand.
# CONTACT_FROM erst nach Domain-Verifizierung auf die eigene Domain setzen;
# ohne Verifizierung nur "onboarding@resend.dev" (sendet nur an die Konto-Adresse).
RESEND_API_KEY=re_DEIN_API_KEY
CONTACT_TO=heiko.schwaninger@gmail.com
CONTACT_FROM=Werde Meister deiner Gedanken <onboarding@resend.dev>

# Gratis-E-Book (Lead-Magnet) – Versand über /api/ebook
# Nur RESEND_API_KEY gesetzt  → E-Book wird nach dem Eintragen direkt
#   verschickt (kein Double-Opt-in, keine Lead-Speicherung).
# Zusätzlich SUPABASE_SERVICE_ROLE_KEY (s. u.) + Migration 0005_ebook_leads.sql
#   → Double-Opt-in: Interessent*innen bestätigen erst per E-Mail, dann kommt
#   das E-Book; die Leads landen in der Tabelle public.ebook_leads.
# Ohne RESEND_API_KEY bietet das Formular den direkten Download an.
# EBOOK_FROM ist optional (fällt sonst auf CONTACT_FROM zurück).
EBOOK_FROM=Werde Meister deiner Gedanken <onboarding@resend.dev>

# E-Mail-Impulse (wöchentlich) – siehe docs/EMAIL-IMPULSE.md
# SUPABASE_SERVICE_ROLE_KEY: Service-Role-Key (Supabase → Project Settings → API).
#   NIEMALS mit NEXT_PUBLIC_ prefixen – dieser Key umgeht Row-Level-Security
#   und darf ausschließlich serverseitig genutzt werden.
# CRON_SECRET: frei gewähltes Geheimnis, das die Versand-Route schützt.
# IMPULSE_FROM: Absender der Impulse (fällt sonst auf CONTACT_FROM zurück).
SUPABASE_SERVICE_ROLE_KEY=DEIN-SERVICE-ROLE-KEY
CRON_SECRET=EIN-LANGES-ZUFAELLIGES-GEHEIMNIS
IMPULSE_FROM=Werde Meister deiner Gedanken <onboarding@resend.dev>

# Bezahl-Mitgliedschaft – Stripe-Abo (siehe docs/STRIPE-MITGLIEDSCHAFT.md)
# STRIPE_SECRET_KEY: geheimer API-Key (Stripe → Developers → API keys).
#   NIEMALS mit NEXT_PUBLIC_ prefixen. Test: sk_test_… / Live: sk_live_…
# STRIPE_PRICE_ID: Preis-ID des wiederkehrenden Abo-Produkts (price_…).
# STRIPE_WEBHOOK_SECRET: Signatur-Geheimnis des Webhook-Endpoints (whsec_…),
#   Endpoint in Stripe auf  https://DEINE-DOMAIN/api/stripe/webhook  setzen
#   (Events: checkout.session.completed, customer.subscription.updated/deleted).
# Voraussetzung fürs Freischalten des Zugangs: SUPABASE_SERVICE_ROLE_KEY (s. o.)
#   und Migration 0007_membership.sql. MEMBERSHIP_FROM optional (sonst CONTACT_FROM).
# Ohne diese Variablen fällt der „Mitglied werden“-Button sanft aufs Kontaktformular.
STRIPE_SECRET_KEY=sk_test_DEIN_KEY
STRIPE_PRICE_ID=price_DEINE_MONATS_PREIS_ID
# Optional: Jahresabo (zweiter Preis am selben Produkt) → schaltet die Jahres-Option frei.
STRIPE_PRICE_ID_YEARLY=price_DEINE_JAHRES_PREIS_ID
# Buch-Einmalkauf „Werde Meister deiner Gedanken" (29,90 €) – eigener Preis eines
# Nicht-Abo-Produkts (price_…). Steuert den „Bestellen"-Button auf /buch.
# Ohne diese Variable fällt der Button sanft aufs Kontaktformular zurück.
STRIPE_BOOK_PRICE_ID=price_DEINE_BUCH_PREIS_ID
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET
MEMBERSHIP_FROM=Werde Meister deiner Gedanken <onboarding@resend.dev>
# Bezahlschranke für /mitglieder erst nach getestetem Checkout aktivieren:
REQUIRE_ACTIVE_MEMBERSHIP=false
# Freie Selbst-Registrierung (Konten ohne Zahlung). Standard aus.
# Beim Modell „Bezahlen zuerst“ NICHT setzen – Konten entstehen über den Checkout.
# Nur für „erst registrieren, dann bezahlen“ auf true setzen:
ALLOW_SELF_REGISTRATION=false

# KI-Funktionen (Reading zum Gedankenprofil + Begleiter im Mitgliederbereich)
# ANTHROPIC_API_KEY: API-Key von Anthropic (https://console.anthropic.com).
#   NIEMALS mit NEXT_PUBLIC_ prefixen – wird ausschließlich serverseitig genutzt.
#   Ein Key versorgt beide Funktionen:
#
#   1) KI-Reading zum Gedankenprofil (/mitglieder/gedankenprofil)
#      Ohne Key bleibt das Gedankenprofil voll nutzbar (rein regelbasiert);
#      die Option „Reading erzeugen“ wird dann einfach nicht angezeigt.
#      Voraussetzung außerdem: Migration 0008_gedanken_readings.sql einspielen.
#      Ein Reading wird nie automatisch erzeugt, sondern nur auf Klick.
#
#   2) Begleiter – KI-Gespräch im Mitgliederbereich (/mitglieder/begleiter)
#      Voraussetzung außerdem: Migration 0009_begleiter_chat.sql einspielen
#      (speichert den Gesprächsverlauf je Mitglied, per RLS geschützt).
#      Ohne Key (oder ohne Migration) bleibt die Seite erreichbar und meldet,
#      dass der Begleiter noch nicht eingerichtet ist; der Link im
#      Mitglieder-Dashboard wird dann gar nicht erst angezeigt.
#      Kostenbremse: 40 Nachrichten pro Mitglied und Tag (Admins ausgenommen),
#      einstellbar in src/lib/begleiter.ts (DAILY_MESSAGE_LIMIT).
ANTHROPIC_API_KEY=sk-ant-DEIN_API_KEY

# Google Analytics 4 (GA4) – Reichweitenmessung
# NEXT_PUBLIC_GA_ID: Measurement-ID der GA4-Property (Format G-XXXXXXXXXX),
#   zu finden im GA-Konto unter: Verwaltung → Datenströme → Web.
#   KEIN Code-Default mehr: ist die Variable nicht gesetzt, bleibt Analytics
#   komplett inaktiv (nichts geladen, kein Cookie-Banner). In Produktion also
#   ausdrücklich setzen, sonst wird nicht gemessen.
# WICHTIG (DSGVO): GA lädt erst NACH aktiver Einwilligung über den Cookie-Banner.
NEXT_PUBLIC_GA_ID=G-XF5D83V7HD

# Domain-Kanonisierung (siehe docs/DOMAIN-UMZUG.md)
# true  = neu./nackte Domain → 301 auf www (Standard)
# false = vorübergehend abschalten, solange www noch nicht live ist
# Lokal irrelevant (localhost wird nicht umgeleitet).
ENFORCE_CANONICAL_HOST=true
