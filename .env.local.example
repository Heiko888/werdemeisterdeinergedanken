# Supabase – Mitgliederbereich
# Werte findest du im Supabase-Dashboard unter: Project Settings → API
# Diese Datei nach ".env.local" kopieren und Werte eintragen (lokal),
# bzw. in Vercel unter Settings → Environment Variables hinterlegen.

NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-ODER-PUBLISHABLE-KEY

# Kontaktformular – Resend (https://resend.com)
# RESEND_API_KEY ist Pflicht für den Versand.
# CONTACT_FROM erst nach Domain-Verifizierung auf die eigene Domain setzen;
# ohne Verifizierung nur "onboarding@resend.dev" (sendet nur an die Konto-Adresse).
RESEND_API_KEY=re_DEIN_API_KEY
CONTACT_TO=heiko.schwaninger@gmail.com
CONTACT_FROM=Werde Meister deiner Gedanken <onboarding@resend.dev>

# E-Mail-Impulse (wöchentlich) – siehe docs/EMAIL-IMPULSE.md
# SUPABASE_SERVICE_ROLE_KEY: Service-Role-Key (Supabase → Project Settings → API).
#   NIEMALS mit NEXT_PUBLIC_ prefixen – dieser Key umgeht Row-Level-Security
#   und darf ausschließlich serverseitig genutzt werden.
# CRON_SECRET: frei gewähltes Geheimnis, das die Versand-Route schützt.
# IMPULSE_FROM: Absender der Impulse (fällt sonst auf CONTACT_FROM zurück).
SUPABASE_SERVICE_ROLE_KEY=DEIN-SERVICE-ROLE-KEY
CRON_SECRET=EIN-LANGES-ZUFAELLIGES-GEHEIMNIS
IMPULSE_FROM=Werde Meister deiner Gedanken <onboarding@resend.dev>

# Domain-Kanonisierung (siehe docs/DOMAIN-UMZUG.md)
# true  = neu./nackte Domain → 301 auf www (Standard)
# false = vorübergehend abschalten, solange www noch nicht live ist
# Lokal irrelevant (localhost wird nicht umgeleitet).
ENFORCE_CANONICAL_HOST=true
