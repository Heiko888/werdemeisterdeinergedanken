# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ... aber die Vorlagen (*.example) mitversionieren:
!.env.local.example
!deploy/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PDF-Generator (Build-Zwischenstände)
tools/pdf/.build/

# Cover-Studio: exportierte PNG + eigene Hintergrundbilder (nicht versionieren)
docs/reels/covers/export/
docs/reels/covers/export-overlay/
docs/reels/covers/**/vorlage.png

# Carousel-Studio: generierte Slides/PNG + kopierte Assets (nicht versionieren)
docs/carousels/build/
docs/carousels/export/
docs/carousels/export-overlay/
docs/carousels/export-jpg/
docs/carousels/_fonts.css
docs/carousels/logo.png
docs/carousels/logo-gold.png
docs/carousels/**/vorlage.png

# Vorlagen-Galerie (generiert, ~650 MB Binaerdaten).
# Liegt seit 18.08.2026 unter /opt/website-vorlagen auf dem Server und wird
# per Volume nach /app/content/vorlagen in den Container gemountet – siehe
# docs/generatoren/marketing-und-galerie.md. Der Katalog
# src/lib/vorlagen-assets.ts bleibt versioniert, die Binaerdaten nicht:
# sie sind reproduzierbar (npm run vorlagen:galerie) und haben das Repo
# sonst pro Lauf um mehrere hundert MB wachsen lassen.
content/vorlagen/

# Python-Cache
__pycache__/
*.pyc
